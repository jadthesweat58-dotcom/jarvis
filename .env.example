# ---- Required: Jarvis's brain ----------------------------------------------
# gemini (Google, default) or claude (Anthropic)
JARVIS_PROVIDER=gemini
# Gemini key from https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Only if JARVIS_PROVIDER=claude: key from https://console.anthropic.com
ANTHROPIC_API_KEY=

# ---- About you -------------------------------------------------------------
MY_NAME=Sir
# Your timezone (IANA name), e.g. America/New_York, Europe/London, Asia/Dubai
TIMEZONE=UTC
# Your default city for weather ("what's the weather?")
HOME_CITY=

# ---- Jarvis ----------------------------------------------------------------
# cloud = safe mode (no computer control). local = can open apps, run commands, read files.
JARVIS_MODE=cloud
# Leave empty for the default: gemini-3.8-flash (Gemini) or claude-opus-5 (Claude).
# Cheaper Gemini option: gemini-3.1-flash-lite
JARVIS_MODEL=
# low | medium | high  (lower = faster & cheaper replies, higher = smarter)
JARVIS_EFFORT=medium
# Morning briefing time (your local time, HH:MM), or "off"
BRIEFING_TIME=07:30
# Evening wrap-up time (your local time, HH:MM), or "off"
WRAPUP_TIME=21:00
# Password for the web app. REQUIRED when Jarvis is on the internet.
# Visiting from the same computer (localhost) works without it.
JARVIS_ACCESS_TOKEN=
# Where Jarvis stores its memory database (a file on this computer)
JARVIS_DATA_DIR=data
# ...or keep memory online (needed on free cloud hosting that wipes its disk).
# Supabase: Project > Connect > "Session pooler" connection string, with your
# database password filled in. When set, JARVIS_DATA_DIR isn't used.
DATABASE_URL=
# Alternative online database: Turso (https://turso.tech)
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=
# Folder Jarvis may read/list files in (local mode). Defaults to your home folder.
JARVIS_FILES_ROOT=

# ---- Jarvis's voice (optional, https://elevenlabs.io) -----------------------
# Without these, replies are spoken with the browser's built-in voice.
ELEVENLABS_API_KEY=
# Voice Library > pick a voice > copy its Voice ID
ELEVENLABS_VOICE_ID=
# Leave empty for the fast default (eleven_flash_v2_5)
ELEVENLABS_MODEL=
# Characters per month on your ElevenLabs plan (free plan: 10000), for the usage meter
ELEVENLABS_MONTHLY_CHARS=10000

# ---- Library search and pictures (optional; both use GEMINI_API_KEY) ----------
# Leave empty for the defaults: gemini-embedding-001, and the newest Gemini "flash image" model
EMBED_MODEL=
IMAGE_MODEL=

# ---- Your calendar (optional, read-only, no sign-in needed) ------------------
# Google Calendar: Settings > click your calendar > "Secret address in iCal format".
# Outlook/iCloud: share or publish the calendar and copy the .ics link.
# Several calendars: separate the links with commas. Keep these private.
CALENDAR_ICS_URL=

# ---- Gmail (optional): your own Google OAuth client. See README "Gmail". ------
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ---- Telegram (optional): message Jarvis from your phone ----------------------
# In Telegram, talk to @BotFather, send /newbot, and paste the token it gives you.
# Then in Jarvis: Settings (gear) > Link Telegram.
TELEGRAM_BOT_TOKEN=

# ---- Clap twice to open Jarvis (your own computer only) ----------------------
# Run scripts/clap.command (Mac) or scripts\clap.bat (Windows).
# Which Jarvis to open: this computer's, or your cloud one (e.g. https://jarvis-xxxx.onrender.com)
JARVIS_URL=http://localhost:8000
# 1-10: higher hears quieter claps (and more false alarms)
CLAP_SENSITIVITY=5
# After the greeting, read today's briefing (on/off). For a cloud JARVIS_URL, also set
# JARVIS_ACCESS_TOKEN above so it's allowed to fetch it.
CLAP_BRIEFING=on
# Menu-bar app (scripts/autostart.command): start listening for claps right away (on/off)
CLAP_ON_START=on

# ---- Phone calls & texts (optional, via Twilio: https://www.twilio.com) -------
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
# Your Twilio phone number, in +15551234567 format
TWILIO_PHONE_NUMBER=
# YOUR real phone number, so Jarvis can call/text you
MY_PHONE_NUMBER=
# The public https address of your Jarvis server (needed for two-way phone
# conversations), e.g. https://my-jarvis.onrender.com
PUBLIC_BASE_URL=
